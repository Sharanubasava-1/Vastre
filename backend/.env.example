ADMIN_EMAIL=
ADMIN_PASSWORD=
FIREBASE_PROJECT_ID=your-firebase-project-id
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_HOURS=24
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Authentication hardening. Positive integers; restart the backend after changes.
LOGIN_RATE_PER_MIN=5
REGISTER_RATE_PER_HOUR=5
GOOGLE_RATE_PER_MIN=20
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_MIN=15
LOGIN_LOCKOUT_MAX_MIN=60
LOGIN_FAILURE_WINDOW_MIN=60
ADMIN_IDLE_MIN=30
REQUIRE_VERIFIED_EMAIL=false
EMAIL_VERIFICATION_HOURS=24
EMAIL_VERIFICATION_RATE_PER_HOUR=3
PUBLIC_BASE_URL=http://localhost:8000
# report-only is available for a staged rollout; final default is enforce.
CSP_MODE=enforce

# Optional SMTP. Without a host, development prints verification emails to console.
# With COOKIE_SECURE=true, SMTP is required; verification links are never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vastre.example
SMTP_STARTTLS=true
